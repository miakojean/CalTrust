### 4. VISUALISER LES NOTIFICATIONS DE L'ENTREPRISE
GET {{base_url}}/core/notifications/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzU1OTkwNjg4LCJpYXQiOjE3NTU5ODM0ODgsImp0aSI6IjYxZjRlZTJkZmY0NzQwMjliN2VhOGNkNjA3ZDUxYjY5IiwidXNlcl9pZCI6M30.OZ9yXjx7dk_P5NXmRA3QiTkYGSVmLTtyFoHs1Ht0TGA
