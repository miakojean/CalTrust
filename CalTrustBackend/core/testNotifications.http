### 4. VISUALISER LES NOTIFICATIONS DE L'ENTREPRISE
GET {{base_url}}/core/notifications/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzU1OTA3ODk0LCJpYXQiOjE3NTU5MDA2OTQsImp0aSI6IjM0OTQ1YzZkM2FmYzQ5MzNiYzQ4M2ExN2FiNzU3NGNhIiwidXNlcl9pZCI6M30.X2oHXroN4mILeHLJaa7IUvOef9PiTbTMtcQZdrq2xpY
Content-Type: {{content_type}}

### 5. VISUALISER SEULEMENT LES NOTIFICATIONS NON LUES
GET {{base_url}}/notifications/?read=false
Authorization: Bearer 
Content-Type: {{content_type}}

### 6. VISUALISER SEULEMENT LES NOTIFICATIONS LUES
GET {{base_url}}/notifications/?read=true
Authorization: Bearer 
Content-Type: {{content_type}}

### 7. MARQUER UNE NOTIFICATION COMME LUE
# Remplacer {notification_id} par l'ID réel d'une notification
PATCH {{base_url}}/core/notifications/1/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzU1OTgwMzA5LCJpYXQiOjE3NTU5NzMxMDksImp0aSI6IjYwNjNiZDg2N2FjZDQwOGNiOGZkOWYwMTdkZjk4YjFiIiwidXNlcl9pZCI6M30.q0YfzjooRceyMWkSJv4N75ObDB-esxEvzcHcj5pdoGE 
Content-Type: {{content_type}}

{
  "is_read": true
}

### 8. MARQUER TOUTES LES NOTIFICATIONS COMME LUES
POST {{base_url}}/notifications/actions/
Authorization: Bearer 
Content-Type: {{content_type}}

{
  "action": "mark_all_read"
}

### 9. SUPPRIMER LES NOTIFICATIONS LUES
POST {{base_url}}/notifications/actions/
Authorization: Bearer 
Content-Type: {{content_type}}

{
  "action": "clear_all"
}

### 10. OBTENIR LE NOMBRE DE NOTIFICATIONS NON LUES
GET {{base_url}}/notifications/unread-count/
Authorization: Bearer 
Content-Type: {{content_type}}

### 11. VOIR UNE NOTIFICATION SPÉCIFIQUE
# Remplacer {notification_id} par l'ID réel
GET {{base_url}}/notifications/{notification_id}/
Authorization: Bearer 
Content-Type: {{content_type}}